    {
      "name": "4. Eventos: región (bbox) + fechas",
      "request": {
        "method": "GET",
        "description": "La consulta básica: eventos activos en la región y las fechas, con lat/lon y caja.",
        "url": {
          "raw": "{{baseUrl}}/events?bbox=-75.7,-11.5,-70.4,-7.2&start=2024-09-01&end=2024-09-30&limit=200",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "events"
          ],
          "query": [
            {
              "key": "bbox",
              "value": "-75.7,-11.5,-70.4,-7.2",
              "description": "lon_min,lat_min,lon_max,lat_max"
            },
            {
              "key": "start",
              "value": "2024-09-01"
            },
            {
              "key": "end",
              "value": "2024-09-30"
            },
            {
              "key": "limit",
              "value": "200"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('responde 200', () => pm.response.to.have.status(200));",
              "pm.test('responde en menos de 3 s', () => pm.expect(pm.response.responseTime).to.be.below(3000));",
              "const body = pm.response.json();",
              "const [x0, y0, x1, y1] = pm.request.url.query.get('bbox').split(',').map(Number);",
              "pm.test('hay eventos', () => pm.expect(body.total).to.be.above(0));",
              "pm.test('cada evento tiene lat y lon numéricos', () => body.events.forEach(e => { pm.expect(e.lat).to.be.a('number'); pm.expect(e.lon).to.be.a('number'); }));",
              "pm.test('la caja de cada evento toca la región', () => body.events.forEach(e => { pm.expect(e.lon_max).to.be.at.least(x0); pm.expect(e.lon_min).to.be.at.most(x1); pm.expect(e.lat_max).to.be.at.least(y0); pm.expect(e.lat_min).to.be.at.most(y1); }));",
              "pm.test('cada evento estuvo activo en las fechas', () => body.events.forEach(e => { pm.expect(new Date(e.t_start) <= new Date('2024-10-01T00:00:00Z')).to.be.true; pm.expect(new Date(e.t_end) >= new Date('2024-09-01T00:00:00Z')).to.be.true; }));",
              "// Guarda el evento con más detecciones para las peticiones 11 y 12.",
              "const big = body.events.reduce((a, b) => (b.n_det > a.n_det ? b : a));",
              "pm.collectionVariables.set('eventId', big.event_id);",
              "pm.collectionVariables.set('eventNdet', big.n_det);"
            ]
          }
        }
      ]
    },
